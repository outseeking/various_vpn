<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Общая группа: единственный способ передать состояние из приложения в
	     виджет — процессы у них разные, общей памяти нет. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.variousVpn</string>
	</array>
</dict>
</plist>
