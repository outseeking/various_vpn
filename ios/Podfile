# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Расширение Packet Tunnel Provider. Плагины Flutter ему не нужны — VPN-ядро
# (libXray + hev-socks5-tunnel) подключается как xcframework в Xcode вручную
# (см. ios/README_iOS.md). Если ядро распространяется через CocoaPods — добавь
# сюда его pod.
#
# ВАЖНО: таргет расширения появляется в проекте только после запуска
# `ruby setup_ios_extension.rb` на Mac. На чистом клоне и в облачном CI его ещё
# нет — тогда этот блок нужно пропустить, иначе `pod install` падает с ошибкой
# «Unable to find a target named PacketTunnelProvider». Проверяем наличие таргета
# прямо в project.pbxproj.
_pbxproj = File.join(__dir__, 'Runner.xcodeproj', 'project.pbxproj')
if File.exist?(_pbxproj) && File.read(_pbxproj).include?('PacketTunnelProvider')
  target 'PacketTunnelProvider' do
    use_frameworks!

    # Перекачка utun ↔ SOCKS. Обёртка над hev-socks5-tunnel с уже собранным
    # бинарником: система отдаёт расширению сырые IP-пакеты, а Xray понимает
    # только SOCKS — без этого переводчика туннель поднимется, но трафик
    # стоять будет.
    # Версия последняя из опубликованных. Ставилась «~> 5.16» — такой в
    # каталоге нет вовсе, и сборка падала не на компиляции, а раньше: на
    # разрешении зависимостей.
    pod 'Tun2SocksKit', '~> 5.14'
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
