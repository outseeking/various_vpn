<?xml version="1.0" encoding="utf-8"?>
<!-- Домашний виджет Various VPN. Стиль приложения: тёмная карточка,
     лаймово-фиолетовый акцент, флаг+сервер, кнопка подключения и измерения пинга. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/vv_widget_bg"
    android:padding="14dp">

    <!-- Верхняя строка: иконка приложения + статус + точка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/vv_badge"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Various VPN" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VARIOUS VPN"
                android:textColor="#8AFFFFFF"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/vv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textSize="19sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageView
            android:id="@+id/vv_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/vv_dot_off"
            android:contentDescription="status" />
    </LinearLayout>

    <!-- Пилюля: флаг + имя сервера + пинг + кнопка измерения -->
    <LinearLayout
        android:id="@+id/vv_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/vv_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/vv_flag"
            android:layout_width="30dp"
            android:layout_height="21dp"
            android:src="@drawable/vv_globe"
            android:scaleType="fitCenter"
            android:contentDescription="country" />

        <TextView
            android:id="@+id/vv_server"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Not selected"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/vv_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text=""
            android:textColor="#9BCB3C"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/vv_ping_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/vv_ping_btn_bg"
            android:padding="7dp"
            android:src="@drawable/vv_ic_ping"
            android:contentDescription="measure ping" />
    </LinearLayout>

    <!-- Кнопка подключить/отключить -->
    <TextView
        android:id="@+id/vv_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Connect"
        android:textColor="#0C1206"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:textSize="16sp"
        android:includeFontPadding="false"
        android:background="@drawable/vv_btn_connect" />
</LinearLayout>
