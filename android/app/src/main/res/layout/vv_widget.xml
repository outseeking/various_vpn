<?xml version="1.0" encoding="utf-8"?>
<!-- Домашний виджет Various VPN — вёрстка в стиле приложения:
     тёмная карточка с градиентом, лаймово-фиолетовый акцент, крупный статус,
     «пилюля» сервера с флагом и пингом, широкая кнопка подключения.
     В бесплатном режиме вместо флага показывается значок Telegram, а кнопка
     замера пинга скрывается (нативно, см. VariousWidgetProvider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/vv_widget_bg"
    android:padding="12dp">

    <!-- Шапка: логотип · бренд и статус · индикатор -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/vv_badge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:src="@drawable/vv_badge_classic"
            android:contentDescription="Various VPN" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VARIOUS VPN"
                android:textColor="#7AFFFFFF"
                android:letterSpacing="0.18"
                android:fontFamily="sans-serif-medium"
                android:textSize="9sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/vv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Disconnected"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/vv_dot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/vv_dot_off"
            android:contentDescription="status" />
    </LinearLayout>

    <!-- Пилюля: флаг (или значок Telegram) + название + пинг + замер -->
    <LinearLayout
        android:id="@+id/vv_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/vv_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/vv_flag"
            android:layout_width="30dp"
            android:layout_height="21dp"
            android:src="@drawable/vv_globe"
            android:scaleType="fitCenter"
            android:contentDescription="country" />

        <!-- Показывается вместо флага в бесплатном режиме -->
        <ImageView
            android:id="@+id/vv_tg"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:src="@drawable/vv_ic_telegram"
            android:scaleType="fitCenter"
            android:contentDescription="Telegram" />

        <TextView
            android:id="@+id/vv_server"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Not selected"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/vv_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textColor="#A3E635"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/vv_ping_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/vv_ping_btn_bg"
            android:padding="7dp"
            android:src="@drawable/vv_ic_ping"
            android:contentDescription="measure ping" />
    </LinearLayout>

    <!-- Главная кнопка -->
    <TextView
        android:id="@+id/vv_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="44dp"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Connect"
        android:textColor="#0C1206"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:textSize="15sp"
        android:letterSpacing="0.03"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/vv_btn_connect" />
</LinearLayout>
