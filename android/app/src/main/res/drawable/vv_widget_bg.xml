<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджета: глубокая тёмная карточка с фирменным лаймово-фиолетовым
     переливом по диагонали — как карточки в приложении. Рамка мягкая,
     чтобы виджет не спорил с обоями, но читался как отдельный объект. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--базовая подложка с градиентом -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="125"
                android:startColor="#101C33"
                android:centerColor="#0A1120"
                android:endColor="#05070C" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- лаймовый акцент в верхнем левом углу (мягкое свечение) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#2EA3E635"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- фиолетовый акцент снизу справа -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#2A7C3AED"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#2EA3E635" />
        </shape>
    </item>
</layer-list>
