<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджета: тёмная карточка в стиле приложения с тонкой лаймовой рамкой. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="115"
        android:startColor="#0B1120"
        android:centerColor="#070D18"
        android:endColor="#05070C" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#339BCB3C" />
    <padding android:left="16dp" android:top="14dp" android:right="16dp" android:bottom="14dp" />
</shape>
