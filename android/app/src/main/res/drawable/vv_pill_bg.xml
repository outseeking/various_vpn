<?xml version="1.0" encoding="utf-8"?>
<!-- «Пилюля» сервера: чуть светлее фона, со стеклянной кромкой — так строка
     читается как отдельный элемент, а не сливается с карточкой. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#18233A"
        android:endColor="#111A2C" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
