<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- VPN-ядро: доступ в сеть + foreground-сервис VPN (flutter_v2ray сам
         регистрирует свой VpnService, но эти разрешения нужны приложению). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Просьба не усыплять приложение в фоне. На прошивках Huawei/Honor и
         Xiaomi система выгружает фоновые сервисы агрессивнее обычного, и
         VPN-туннель обрывался «просто так», без действий пользователя.
         Разрешение только позволяет ПОКАЗАТЬ системный запрос — решает
         по-прежнему человек. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Камера — сканирование QR-кода подписки из бота. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Авто-VPN в незнакомых сетях: чтение имени Wi-Fi (SSID) требует доступа
         к геолокации; состояние сети — для отслеживания смены Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Список установленных приложений для раздельного туннелирования (per-app). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <application
        android:label="Various VPN"
        android:name="${applicationName}"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Вариант иконки «classic». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasClassic"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_classic"
            android:roundIcon="@mipmap/ic_launcher_classic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Вариант иконки «midnight». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasMidnight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Вариант иконки «indigo». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasIndigo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Вариант иконки «steel». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasSteel"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_steel"
            android:roundIcon="@mipmap/ic_launcher_steel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Вариант иконки «pearl». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasPearl"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_pearl"
            android:roundIcon="@mipmap/ic_launcher_pearl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Вариант иконки «lime». Включается из настроек через
             PackageManager.setComponentEnabledSetting (см. MainActivity). -->
        <activity-alias
            android:name=".IconAliasLime"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Various VPN"
            android:icon="@mipmap/ic_launcher_lime"
            android:roundIcon="@mipmap/ic_launcher_lime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Домашний виджет Various VPN -->
        <receiver
            android:name=".VariousWidgetProvider"
            android:exported="true"
            android:label="Various VPN">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vv_widget_info" />
        </receiver>

        <!-- Обработчик кнопок виджета (вкл/выкл + пинг) без открытия приложения -->
        <receiver
            android:name=".VariousWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.various_vpn.WIDGET_TOGGLE" />
                <action android:name="com.example.various_vpn.WIDGET_PING" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
